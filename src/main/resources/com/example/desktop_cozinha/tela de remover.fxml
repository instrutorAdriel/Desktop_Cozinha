<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">

    <children>

        <ImageView fitHeight="400.0" fitWidth="503.0" opacity="0.3" pickOnBounds="true" preserveRatio="true">

            <image>
                <Image url="@imagem/Logo%20colorida%20Senac.png" />
            </image>

        </ImageView>

        <VBox alignment="CENTER" prefHeight="400" prefWidth="600" spacing="15">

            <children>

                <HBox alignment="CENTER" spacing="10">

                    <children>

                        <ImageView fitHeight="35.0" fitWidth="41.0" preserveRatio="true">

                            <image>
                                <Image url="@imagem/ChatGPT%20Image%2012%20de%20mai.%20de%202026,%2011_00_57.png" />
                            </image>

                        </ImageView>

                        <Label text="Remover Produto" textFill="#d32f2f">

                            <font>
                                <Font name="System Bold" size="21.0" />
                            </font>

                        </Label>

                    </children>

                </HBox>

                <Label text="Você está prestes a remover este produto do estoque,">

                    <font>
                        <Font size="15.0" />
                    </font>

                </Label>

                <Label text="Esta ação não pode ser desfeita.">

                    <font>
                        <Font size="15.0" />
                    </font>

                </Label>

                <Separator prefWidth="500" />

                <HBox alignment="CENTER" spacing="20">

                    <children>

                        <Button mnemonicParsing="false" prefHeight="35.0" prefWidth="190.0" style="-fx-background-radius: 8;" text="- Cancelar">

                            <font>
                                <Font name="Arial" size="15.0" />
                            </font>

                        </Button>

                        <Button mnemonicParsing="false" prefHeight="35.0" prefWidth="190.0" style="-fx-background-color: #d32f2f; -fx-text-fill: white; -fx-background-radius: 8;" text="🗑 Confirmar Remoção">

                            <font>
                                <Font size="15.0" />
                            </font>

                        </Button>

                    </children>

                </HBox>

            </children>

        </VBox>

    </children>

</StackPane>