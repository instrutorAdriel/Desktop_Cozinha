<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.desktop_cozinha.controller.RemoverProdutosController">

    <center>

        <StackPane prefHeight="400.0" prefWidth="500.0" BorderPane.alignment="CENTER">

            <children>

                <ImageView fitHeight="400.0" fitWidth="503.0" opacity="0.3" pickOnBounds="true" preserveRatio="true">

                    <image>
                        <Image url="@imagens/Logo%20colorida%20Senac.png" />
                    </image>

                </ImageView>

                <VBox alignment="CENTER" prefHeight="400" prefWidth="600" spacing="15">

                    <children>

                        <Label text="Remover Produto" textFill="#d32f2f">

                            <font>
                                <Font name="System Bold" size="21.0" />
                            </font>

                            <graphic>

                                <ImageView fitHeight="35.0" fitWidth="41.0" preserveRatio="true">

                                    <image>
                                        <Image url="@imagens/imagem.png" />
                                    </image>

                                </ImageView>

                            </graphic>

                        </Label>

                        <HBox alignment="CENTER" spacing="10" />

                        <Label text="Você está prestes a remover este produto do estoque,">

                            <font>
                                <Font name="Arial Bold" size="15.0" />
                            </font>

                        </Label>

                        <Label text="Esta ação não pode ser desfeita.">

                            <font>
                                <Font name="Arial Bold" size="15.0" />
                            </font>

                        </Label>

                        <Separator prefWidth="500" />

                        <HBox alignment="CENTER" spacing="20">

                            <children>

                                <Button mnemonicParsing="false" prefHeight="35.0" prefWidth="190.0" style="-fx-background-radius: 8;" styleClass="btn-cancelar" stylesheets="@css/estilo.css" text=" Cancelar">

                                    <font>
                                        <Font name="Arial Bold" size="15.0" />
                                    </font>

                                </Button>

                                <Button mnemonicParsing="false" prefHeight="35.0" prefWidth="190.0" style="-fx-background-radius: 8;" styleClass="btn-remover" stylesheets="@css/estilo.css" text="🗑 Confirmar Remoção">

                                    <font>
                                        <Font name="Arial Bold" size="15.0" />
                                    </font>

                                </Button>

                            </children>

                        </HBox>

                    </children>

                </VBox>

            </children>
            <BorderPane.margin>
                <Insets />
            </BorderPane.margin>

        </StackPane>

    </center>

</BorderPane>
