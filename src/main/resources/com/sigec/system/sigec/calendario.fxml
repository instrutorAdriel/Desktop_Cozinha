<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.effect.ColorAdjust?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="768.0" prefWidth="1366.0" stylesheets="@CSS/StyleSheet.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sigec.system.sigec.Controllers.CalendarioController">
    <!-- Cabeçalho Topo -->
    <top>
        <AnchorPane fx:id="topBarPane" prefHeight="50.0" styleClass="top-bar-pane" BorderPane.alignment="CENTER">
            <children>
                <HBox alignment="CENTER_LEFT" prefHeight="50.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="35.0" AnchorPane.topAnchor="0.0">
                    <children>
                        <ImageView fx:id="logoSenac" fitHeight="42.0" fitWidth="130.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@imagens/LogocoloridaSenac.png" />
                            </image>
                        </ImageView>
                    </children>
                </HBox>
                <HBox alignment="CENTER_RIGHT" prefHeight="50.0" AnchorPane.bottomAnchor="0.0" AnchorPane.rightAnchor="40.0" AnchorPane.topAnchor="0.0">
                    <children>
                        <Label fx:id="logoSigec" text="S.I.G.E.C" textFill="WHITE">
                            <font>
                                <Font name="Arial Bold" size="24.0" />
                            </font>
                        </Label>
                    </children>
                </HBox>
            </children>
        </AnchorPane>
    </top>

    <!-- Menu Lateral -->
    <left>
        <VBox alignment="TOP_CENTER" prefHeight="550.0" prefWidth="200.0" styleClass="painel-lateral" BorderPane.alignment="CENTER">
            <children>
                <Button id="btnNavHome" alignment="BASELINE_LEFT" graphicTextGap="12.0" mnemonicParsing="false" onAction="#onClickHome" styleClass="btn-padrao" text="Página Inicial">
                    <font>
                        <Font name="Arial Bold" size="15.0" />
                    </font>
                    <graphic>
                        <ImageView fitHeight="22.0" fitWidth="22.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@imagens/home.png" />
                            </image>
                            <effect>
                                <ColorAdjust brightness="1.0" />
                            </effect>
                        </ImageView>
                    </graphic>
                    <VBox.margin>
                        <Insets bottom="15.0" top="20.0" />
                    </VBox.margin>
                </Button>

                <Button id="btnNavEstoque" alignment="BASELINE_LEFT" graphicTextGap="12.0" mnemonicParsing="false" onAction="#onClickEstoque" styleClass="btn-padrao" text="Estoque">
                    <font>
                        <Font name="Arial Bold" size="15.0" />
                    </font>
                    <graphic>
                        <ImageView fitHeight="22.0" fitWidth="22.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@imagens/estoque.png" />
                            </image>
                            <effect>
                                <ColorAdjust brightness="1.0" />
                            </effect>
                        </ImageView>
                    </graphic>
                    <VBox.margin>
                        <Insets bottom="15.0" />
                    </VBox.margin>
                </Button>

                <Button id="btnNavUtensilios" alignment="BASELINE_LEFT" graphicTextGap="12.0" mnemonicParsing="false" onAction="#onClickUtensilios" styleClass="btn-padrao" text="Utensílios">
                    <font>
                        <Font name="Arial Bold" size="15.0" />
                    </font>
                    <graphic>
                        <ImageView fitHeight="22.0" fitWidth="22.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@imagens/estoque.png" />
                            </image>
                            <effect>
                                <ColorAdjust brightness="1.0" />
                            </effect>
                        </ImageView>
                    </graphic>
                    <VBox.margin>
                        <Insets bottom="15.0" />
                    </VBox.margin>
                </Button>

                <Button id="btnNavRelatorio" alignment="BASELINE_LEFT" graphicTextGap="12.0" mnemonicParsing="false" onAction="#onClickRelatorio" styleClass="btn-padrao" text="Relatório">
                    <font>
                        <Font name="Arial Bold" size="15.0" />
                    </font>
                    <graphic>
                        <ImageView fitHeight="22.0" fitWidth="22.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@imagens/relatorio.png" />
                            </image>
                            <effect>
                                <ColorAdjust brightness="1.0" />
                            </effect>
                        </ImageView>
                    </graphic>
                    <VBox.margin>
                        <Insets bottom="15.0" />
                    </VBox.margin>
                </Button>

                <Button id="btnNavSolicitacoes" alignment="BASELINE_LEFT" graphicTextGap="12.0" mnemonicParsing="false" onAction="#onClickSolicitacoes" styleClass="btn-padrao" text="Solicitações">
                    <font>
                        <Font name="Arial Bold" size="15.0" />
                    </font>
                    <graphic>
                        <ImageView fitHeight="22.0" fitWidth="22.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@imagens/relatorio.png" />
                            </image>
                            <effect>
                                <ColorAdjust brightness="1.0" />
                            </effect>
                        </ImageView>
                    </graphic>
                    <VBox.margin>
                        <Insets bottom="15.0" />
                    </VBox.margin>
                </Button>

                <!-- Botão Calendário Ativo -->
                <Button id="btnNavCalendario" alignment="BASELINE_LEFT" graphicTextGap="12.0" mnemonicParsing="false" onAction="#onClickCalendario" text="Calendário">
                    <styleClass>
                        <String fx:value="btn-padrao" />
                        <String fx:value="btn-ativo" />
                    </styleClass>
                    <font>
                        <Font name="Arial Bold" size="15.0" />
                    </font>
                    <graphic>
                        <ImageView fitHeight="22.0" fitWidth="22.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@imagens/relatorio.png" />
                            </image>
                            <effect>
                                <ColorAdjust brightness="1.0" />
                            </effect>
                        </ImageView>
                    </graphic>
                    <VBox.margin>
                        <Insets bottom="15.0" />
                    </VBox.margin>
                </Button>
                <!-- Container Cadastros -->
                <VBox alignment="TOP_CENTER" spacing="0.0">
                    <children>
                        <Button id="btnNavCadastro" fx:id="btnNavCadastro" alignment="CENTER_LEFT" mnemonicParsing="false" onAction="#toggleDropdownCadastro" styleClass="btn-padrao">
                            <graphic>
                                <HBox alignment="CENTER_LEFT" prefWidth="160.0" spacing="10.0">
                                    <children>
                                        <ImageView fitHeight="22.0" fitWidth="22.0" pickOnBounds="true" preserveRatio="true">
                                            <image>
                                                <Image url="@imagens/cadastroIMG.png" />
                                            </image>
                                            <effect>
                                                <ColorAdjust brightness="1.0" />
                                            </effect>
                                        </ImageView>
                                        <Label text="Cadastros" textFill="WHITE">
                                            <font>
                                                <Font name="Arial Bold" size="15.0" />
                                            </font>
                                        </Label>
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Label fx:id="setaCadastro" text="▼" textFill="WHITE">
                                            <font>
                                                <Font name="Arial Bold" size="11.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </HBox>
                            </graphic>
                        </Button>
                        <VBox fx:id="submenuCadastro" alignment="TOP_CENTER" managed="false" spacing="0.0" styleClass="submenu-lateral" visible="false">
                            <children>
                                <Button id="btnSubNavUsuario" fx:id="btnSubNavUsuario" alignment="BASELINE_LEFT" graphicTextGap="8.0" mnemonicParsing="false" onAction="#onClickCadastroUsuario" styleClass="btn-sub-opcao" text="Cadastro Usuário">
                                    <graphic>
                                        <Label text="•" textFill="#94a3b8">
                                            <font>
                                                <Font name="Arial Bold" size="14.0" />
                                            </font>
                                        </Label>
                                    </graphic>
                                </Button>
                                <Button id="btnSubNavTurma" fx:id="btnSubNavTurma" alignment="BASELINE_LEFT" graphicTextGap="8.0" mnemonicParsing="false" onAction="#onClickCadastroTurma" styleClass="btn-sub-opcao" text="Cadastro Turma">
                                    <graphic>
                                        <Label text="•" textFill="#94a3b8">
                                            <font>
                                                <Font name="Arial Bold" size="14.0" />
                                            </font>
                                        </Label>
                                    </graphic>
                                </Button>
                            </children>
                        </VBox>
                    </children>
                    <VBox.margin>
                        <Insets bottom="15.0" />
                    </VBox.margin>
                </VBox>
                <Region VBox.vgrow="ALWAYS" />
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Button fx:id="botaoSair" alignment="CENTER" mnemonicParsing="false" onAction="#botaoSairAction" styleClass="btn-sair" text="Sair">
                            <font>
                                <Font name="Arial Bold" size="13.0" />
                            </font>
                        </Button>
                    </children>
                    <VBox.margin>
                        <Insets bottom="20.0" left="15.0" />
                    </VBox.margin>
                </HBox>
            </children>
        </VBox>
    </left>

    <!-- Área de Trabalho Central -->
    <center>
        <StackPane prefHeight="550.0" prefWidth="600.0" BorderPane.alignment="CENTER" styleClass="workspace-bg">
            <children>
                <ImageView fitHeight="400.0" fitWidth="400.0" opacity="0.05" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@imagens/LogocoloridaSenac.png" />
                    </image>
                </ImageView>
                <VBox alignment="TOP_CENTER" prefHeight="550.0" prefWidth="600.0" styleClass="borda-separadora-lateral">
                    <children>
                        <!-- Banner Laranja de Status -->
                        <HBox alignment="CENTER" prefHeight="40.0" styleClass="status-orange-banner">
                            <children>
                                <Label fx:id="dataLabel" textFill="WHITE">
                                    <font>
                                        <Font name="Arial Bold" size="14.0" />
                                    </font>
                                    <HBox.margin>
                                        <Insets left="20.0" />
                                    </HBox.margin>
                                </Label>
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="usuarioLabel" text="Administrador" textFill="WHITE">
                                    <font>
                                        <Font name="Arial Bold" size="15.0" />
                                    </font>
                                </Label>
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="horaLabel" textFill="#fffbeb">
                                    <font>
                                        <Font name="Arial Bold" size="15.0" />
                                    </font>
                                    <HBox.margin>
                                        <Insets right="20.0" />
                                    </HBox.margin>
                                </Label>
                            </children>
                        </HBox>

                        <VBox fx:id="conteudoPagina" VBox.vgrow="ALWAYS" styleClass="bg-transparent" spacing="15.0">
                            <padding>
                                <Insets top="20.0" right="25.0" bottom="25.0" left="25.0"/>
                            </padding>
                            <children>

                                <!-- Barra de Ferramentas / Filtros para o Relatório -->
                                <VBox styleClass="calendar-toolbar" spacing="15.0">
                                    <padding>
                                        <Insets top="15.0" right="20.0" bottom="15.0" left="20.0"/>
                                    </padding>
                                    <children>
                                        <Label text="SELECIONE O PERÍODO PARA GERAR A LISTA DE INSUMOS" textFill="#002f6c">
                                            <font>
                                                <Font name="Arial Bold" size="14.0" />
                                            </font>
                                        </Label>
                                        <HBox alignment="CENTER_LEFT" spacing="15.0">
                                            <children>
                                                <!-- Seletor de Turma -->
                                                <VBox spacing="5.0">
                                                    <children>
                                                        <Label text="Turma / Laboratório" textFill="#64748b">
                                                            <font><Font name="Arial Bold" size="12.0" /></font>
                                                        </Label>
                                                        <ChoiceBox fx:id="cbTurmaLab" prefWidth="250.0" styleClass="custom-choice-box" />
                                                    </children>
                                                </VBox>

                                                <!-- DatePicker Nativo - Data Inicial -->
                                                <VBox spacing="5.0">
                                                    <children>
                                                        <Label text="Data Inicial" textFill="#64748b">
                                                            <font><Font name="Arial Bold" size="12.0" /></font>
                                                        </Label>
                                                        <DatePicker fx:id="dataInicio" prefWidth="150.0" promptText="De" styleClass="custom-date-picker" />
                                                    </children>
                                                </VBox>

                                                <!-- DatePicker Nativo - Data Final -->
                                                <VBox spacing="5.0">
                                                    <children>
                                                        <Label text="Data Final" textFill="#64748b">
                                                            <font><Font name="Arial Bold" size="12.0" /></font>
                                                        </Label>
                                                        <DatePicker fx:id="dataFim" prefWidth="150.0" promptText="Até" styleClass="custom-date-picker" />
                                                    </children>
                                                </VBox>

                                                <!-- BOTÃO DE BUSCAR NO LOCAL DO QUADRADO VERMELHO -->
                                                <VBox alignment="BOTTOM_CENTER">
                                                    <children>
                                                        <Button fx:id="btnBuscarInsumos" mnemonicParsing="false" onAction="#onBuscarInsumos" styleClass="btn-action-secondary" text="Buscar">
                                                            <padding>
                                                                <Insets bottom="8.0" left="15.0" right="15.0" top="8.0" />
                                                            </padding>
                                                        </Button>
                                                    </children>
                                                </VBox>

                                                <Region HBox.hgrow="ALWAYS" />

                                                <!-- Botão Gerar Relatório -->
                                                <VBox alignment="BOTTOM_CENTER">
                                                    <children>
                                                        <Button fx:id="btnGerarLista" mnemonicParsing="false" onAction="#onGerarRelatorio" styleClass="btn-action-primary" text="📄 Gerar Relatório de Insumos">
                                                            <padding>
                                                                <Insets top="8.0" bottom="8.0" left="15.0" right="15.0"/>
                                                            </padding>
                                                        </Button>
                                                    </children>
                                                </VBox>
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>

                                <!-- Card da Tabela de Resultados do Relatório -->
                                <VBox styleClass="card-alertas" VBox.vgrow="ALWAYS">
                                    <children>
                                        <!-- Header da Tabela -->
                                        <HBox alignment="CENTER_LEFT" prefHeight="40.0" styleClass="card-alertas-header">
                                            <padding>
                                                <Insets left="20.0" right="20.0" />
                                            </padding>
                                            <children>
                                                <Label text="LISTA DE INSUMOS SOLICITADOS NO PERÍODO" textFill="WHITE">
                                                    <font>
                                                        <Font name="Arial Bold" size="13.0" />
                                                    </font>
                                                </Label>
                                            </children>
                                        </HBox>

                                        <!-- Tabela de Insumos -->
                                        <TableView fx:id="tabelaInsumos" VBox.vgrow="ALWAYS">
                                            <styleClass>
                                                <String fx:value="table-view" />
                                                <String fx:value="tabela-alertas-custom" />
                                            </styleClass>
                                            <columns>
                                                <TableColumn fx:id="colDataAula" prefWidth="120.0" text="Data da Aula" />
                                                <TableColumn fx:id="colInsumo" prefWidth="250.0" text="Insumo / Produto" />
                                                <TableColumn fx:id="colQuantidadeNecessaria" prefWidth="150.0" text="Qtd. Necessária" />
                                                <TableColumn fx:id="colUnidade" prefWidth="100.0" text="Unidade" />
                                            </columns>
                                            <columnResizePolicy>
                                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                            </columnResizePolicy>
                                        </TableView>
                                    </children>
                                </VBox>

                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </StackPane>
    </center>
</BorderPane>