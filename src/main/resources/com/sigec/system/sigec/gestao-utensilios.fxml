<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="768.0" prefWidth="1366.0" stylesheets="@CSS/StyleSheet.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sigec.system.sigec.Controllers.UtensiliosController">
    <!-- TOP BAR -->
    <top>
        <AnchorPane fx:id="topBarPane" prefHeight="50.0" styleClass="top-bar-pane" BorderPane.alignment="CENTER">
            <children>
                <HBox alignment="CENTER_LEFT" prefHeight="50.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="35.0" AnchorPane.topAnchor="0.0">
                    <children>
                        <ImageView fx:id="logoSenac" fitHeight="42.0" fitWidth="130.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@imagens/LogocoloridaSenac.png" />
                            </image>
                        </ImageView>
                    </children>
                </HBox>
                <HBox alignment="CENTER_RIGHT" prefHeight="50.0" AnchorPane.bottomAnchor="0.0" AnchorPane.rightAnchor="40.0" AnchorPane.topAnchor="0.0">
                    <children>
                        <Label fx:id="logoSigec" text="S.I.G.E.C" textFill="WHITE">
                            <font>
                                <Font name="Arial Bold" size="24.0" />
                            </font>
                        </Label>
                    </children>
                </HBox>
            </children>
        </AnchorPane>
    </top>

    <!-- MENU LATERAL -->
    <left>
        <VBox alignment="TOP_CENTER" prefHeight="550.0" prefWidth="200.0" styleClass="painel-lateral" BorderPane.alignment="CENTER">
            <children>
                <Button id="btnNavHome" alignment="BASELINE_LEFT" graphicTextGap="12.0" mnemonicParsing="false" onAction="#onClickHome" styleClass="btn-padrao" text="Página Inicial">
                    <font>
                        <Font name="Arial Bold" size="15.0" />
                    </font>
                    <graphic>
                        <ImageView fitHeight="22.0" fitWidth="22.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@imagens/home.png" />
                            </image>
                            <effect>
                                <ColorAdjust brightness="1.0" />
                            </effect>
                        </ImageView>
                    </graphic>
                    <VBox.margin>
                        <Insets bottom="15.0" top="20.0" />
                    </VBox.margin>
                </Button>

                <!-- Container do Menu Dropdown de Estoque -->
                <VBox alignment="TOP_CENTER" spacing="0.0">
                    <children>
                        <Button id="btnNavEstoque" fx:id="btnNavEstoque" alignment="CENTER_LEFT" mnemonicParsing="false" onAction="#toggleDropdownEstoque" styleClass="btn-padrao">
                            <graphic>
                                <HBox alignment="CENTER_LEFT" prefWidth="160.0" spacing="10.0">
                                    <children>
                                        <ImageView fitHeight="22.0" fitWidth="22.0" pickOnBounds="true" preserveRatio="true">
                                            <image>
                                                <Image url="@imagens/estoque.png" />
                                            </image>
                                            <effect>
                                                <ColorAdjust brightness="1.0" />
                                            </effect>
                                        </ImageView>
                                        <Label text="Estoque" textFill="WHITE">
                                            <font>
                                                <Font name="Arial Bold" size="15.0" />
                                            </font>
                                        </Label>
                                        <Region HBox.hgrow="ALWAYS" />
                                        <!-- Como a tela de utensílios está ativa, o menu começa aberto (seta pra cima) -->
                                        <Label fx:id="setaEstoque" text="▲" textFill="WHITE">
                                            <font>
                                                <Font name="Arial Bold" size="11.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </HBox>
                            </graphic>
                        </Button>

                        <!-- Submenu com Insumos e Utensílios -->
                        <VBox fx:id="submenuEstoque" alignment="TOP_CENTER" managed="true" spacing="0.0" styleClass="submenu-lateral" visible="true">
                            <children>
                                <!-- Botão Insumos NORMAL -->
                                <Button id="btnSubNavInsumos" fx:id="btnSubNavInsumos" alignment="BASELINE_LEFT" graphicTextGap="8.0" mnemonicParsing="false" onAction="#onClickInsumos" styleClass="btn-sub-opcao" text="Insumos">
                                    <graphic>
                                        <Label text="•" textFill="#94a3b8">
                                            <font>
                                                <Font name="Arial Bold" size="14.0" />
                                            </font>
                                        </Label>
                                    </graphic>
                                </Button>

                                <!-- Botão Utensílios ATIVO -->
                                <Button id="btnSubNavUtensilios" fx:id="btnSubNavUtensilios" alignment="BASELINE_LEFT" graphicTextGap="8.0" mnemonicParsing="false" onAction="#onClickUtensilios" text="Utensílios">
                                    <styleClass>
                                        <String fx:value="btn-sub-opcao" />
                                        <String fx:value="btn-sub-ativo" />
                                    </styleClass>
                                    <graphic>
                                        <Label text="•" textFill="#ff9800">
                                            <font>
                                                <Font name="Arial Bold" size="14.0" />
                                            </font>
                                        </Label>
                                    </graphic>
                                </Button>
                            </children>
                        </VBox>
                    </children>
                    <VBox.margin>
                        <Insets bottom="15.0" />
                    </VBox.margin>
                </VBox>


                <Button id="btnNavRelatorio" alignment="BASELINE_LEFT" graphicTextGap="12.0" mnemonicParsing="false" onAction="#onClickRelatorio" styleClass="btn-padrao" text="Relatório">
                    <font>
                        <Font name="Arial Bold" size="15.0" />
                    </font>
                    <graphic>
                        <ImageView fitHeight="22.0" fitWidth="22.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@imagens/relatorio.png" />
                            </image>
                            <effect>
                                <ColorAdjust brightness="1.0" />
                            </effect>
                        </ImageView>
                    </graphic>
                    <VBox.margin>
                        <Insets bottom="15.0" />
                    </VBox.margin>
                </Button>

                <Button id="btnNavSolicitacoes" alignment="BASELINE_LEFT" graphicTextGap="12.0" mnemonicParsing="false" onAction="#onClickSolicitacoes" styleClass="btn-padrao" text="Solicitações">
                    <font>
                        <Font name="Arial Bold" size="15.0" />
                    </font>
                    <graphic>
                        <ImageView fitHeight="22.0" fitWidth="22.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@imagens/relatorio.png" />
                            </image>
                            <effect>
                                <ColorAdjust brightness="1.0" />
                            </effect>
                        </ImageView>
                    </graphic>
                    <VBox.margin>
                        <Insets bottom="15.0" />
                    </VBox.margin>
                </Button>

                <Button id="btnNavCalendario" fx:id="btnNavCalendario" alignment="BASELINE_LEFT" graphicTextGap="12.0" mnemonicParsing="false" onAction="#botaoCalendarioAction" styleClass="btn-padrao" text="Calendário">
                    <font>
                        <Font name="Arial Bold" size="15.0" />
                    </font>
                    <graphic>
                        <ImageView fitHeight="22.0" fitWidth="22.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@imagens/calendario.png" />
                            </image>
                            <effect>
                                <ColorAdjust brightness="1.0" />
                            </effect>
                        </ImageView>
                    </graphic>
                    <VBox.margin>
                        <Insets bottom="15.0" />
                    </VBox.margin>
                </Button>

                <VBox alignment="TOP_CENTER" spacing="0.0">
                    <children>
                        <Button id="btnNavCadastro" fx:id="btnNavCadastro" alignment="CENTER_LEFT" mnemonicParsing="false" onAction="#toggleDropdownCadastro" styleClass="btn-padrao">
                            <graphic>
                                <HBox alignment="CENTER_LEFT" prefWidth="160.0" spacing="10.0">
                                    <children>
                                        <ImageView fitHeight="22.0" fitWidth="22.0" pickOnBounds="true" preserveRatio="true">
                                            <image>
                                                <Image url="@imagens/cadastroIMG.png" />
                                            </image>
                                            <effect>
                                                <ColorAdjust brightness="1.0" />
                                            </effect>
                                        </ImageView>
                                        <Label text="Cadastros" textFill="WHITE">
                                            <font>
                                                <Font name="Arial Bold" size="15.0" />
                                            </font>
                                        </Label>
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Label fx:id="setaCadastro" text="▼" textFill="WHITE">
                                            <font>
                                                <Font name="Arial Bold" size="11.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </HBox>
                            </graphic>
                        </Button>
                        <VBox fx:id="submenuCadastro" alignment="TOP_CENTER" managed="false" spacing="0.0" styleClass="submenu-lateral" visible="false">
                            <children>
                                <Button id="btnSubNavUsuario" fx:id="btnSubNavUsuario" alignment="BASELINE_LEFT" graphicTextGap="8.0" mnemonicParsing="false" onAction="#onClickCadastroUsuario" styleClass="btn-sub-opcao" text="Cadastro Usuário">
                                    <graphic>
                                        <Label text="•" textFill="#94a3b8">
                                            <font><Font name="Arial Bold" size="14.0" /></font>
                                        </Label>
                                    </graphic>
                                </Button>
                                <Button id="btnSubNavTurma" fx:id="btnSubNavTurma" alignment="BASELINE_LEFT" graphicTextGap="8.0" mnemonicParsing="false" onAction="#onClickCadastroTurma" styleClass="btn-sub-opcao" text="Cadastro Turma">
                                    <graphic>
                                        <Label text="•" textFill="#94a3b8">
                                            <font><Font name="Arial Bold" size="14.0" /></font>
                                        </Label>
                                    </graphic>
                                </Button>
                            </children>
                        </VBox>
                    </children>
                    <VBox.margin>
                        <Insets bottom="15.0" />
                    </VBox.margin>
                </VBox>

                <Region VBox.vgrow="ALWAYS" />
                <Button fx:id="botaoSair" alignment="CENTER" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#botaoSairAction" prefHeight="45.0" styleClass="btn-sair" text="Sair">
                    <font>
                        <Font name="Arial Bold" size="15.0" />
                    </font>
                    <VBox.margin>
                        <Insets bottom="20.0" left="10.0" right="10.0" />
                    </VBox.margin>
                </Button>
            </children>
        </VBox>
    </left>

    <!-- ÁREA CENTRAL -->
    <center>
        <StackPane prefHeight="550.0" prefWidth="600.0" styleClass="workspace-bg" BorderPane.alignment="CENTER">
            <children>
                <ImageView fitHeight="400.0" fitWidth="400.0" opacity="0.05" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@imagens/LogocoloridaSenac.png" />
                    </image>
                </ImageView>
                <VBox alignment="TOP_CENTER" prefHeight="550.0" prefWidth="600.0" styleClass="borda-separadora-lateral">
                    <children>
                        <!-- Banner Laranja de Status -->
                        <HBox alignment="CENTER" maxHeight="40.0" minHeight="40.0" prefHeight="40.0" styleClass="status-orange-banner">
                            <children>
                                <Label fx:id="dataLabel" textFill="WHITE">
                                    <font>
                                        <Font name="Arial Bold" size="14.0" />
                                    </font>
                                    <HBox.margin>
                                        <Insets left="20.0" />
                                    </HBox.margin>
                                </Label>
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="usuarioLabel" text="Administrador" textFill="WHITE">
                                    <font>
                                        <Font name="Arial Bold" size="15.0" />
                                    </font>
                                </Label>
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="horaLabel" textFill="#fffbeb">
                                    <font>
                                        <Font name="Arial Bold" size="15.0" />
                                    </font>
                                    <HBox.margin>
                                        <Insets right="20.0" />
                                    </HBox.margin>
                                </Label>
                            </children>
                        </HBox>

                        <VBox fx:id="conteudoPagina" spacing="15.0" styleClass="bg-transparent" VBox.vgrow="ALWAYS">
                            <padding>
                                <Insets bottom="25.0" left="25.0" right="25.0" top="20.0" />
                            </padding>
                            <children>

                                <!-- Header da Página (Título e Novos Filtros Alinhados à Direita) -->
                                <HBox alignment="CENTER_LEFT" prefHeight="55.0" styleClass="header-alertas-border">
                                    <children>
                                        <Label text="GESTÃO DE UTENSÍLIOS E EQUIPAMENTOS" textFill="#0c356a">
                                            <font>
                                                <Font name="Arial Bold" size="18.0" />
                                            </font>
                                        </Label>

                                        <!-- Espaço flexível para empurrar os ChoiceBoxes para o lado direito -->
                                        <Region HBox.hgrow="ALWAYS" />

                                        <!-- Container dos novos filtros na posição solicitada (Quadro Vermelho) -->
                                        <HBox alignment="CENTER_RIGHT" spacing="15.0">
                                            <children>
                                                <!-- Filtro de Unidade -->
                                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                                    <children>
                                                        <Label text="Unidade:" textFill="#475569">
                                                            <font>
                                                                <Font name="Arial Bold" size="13.0" />
                                                            </font>
                                                        </Label>
                                                        <ChoiceBox fx:id="cbUnidade" prefHeight="35.0" prefWidth="160.0" styleClass="custom-choice-box" />
                                                    </children>
                                                </HBox>

                                                <!-- Filtro de Curso -->
                                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                                    <children>
                                                        <Label text="Curso:" textFill="#475569">
                                                            <font>
                                                                <Font name="Arial Bold" size="13.0" />
                                                            </font>
                                                        </Label>
                                                        <ChoiceBox fx:id="cbCurso" prefHeight="35.0" prefWidth="160.0" styleClass="custom-choice-box" />
                                                    </children>
                                                </HBox>
                                            </children>
                                        </HBox>
                                    </children>
                                    <VBox.margin>
                                        <Insets bottom="10.0" />
                                    </VBox.margin>
                                </HBox>

                                <!-- Barra de Ferramentas / Ações e os antigos filtros -->
                                <HBox alignment="CENTER_LEFT" prefHeight="45.0" spacing="12.0">
                                    <children>
                                        <TextField fx:id="txtPesquisaUtensilio" prefHeight="35.0" prefWidth="250.0" promptText="🔍 Pesquisar utensílio..." styleClass="search-field">
                                            <font><Font name="Arial" size="13.0" /></font>
                                        </TextField>

                                        <!-- Filtro de Laboratório com Label -->
                                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                                            <children>
                                                <Label text="Laboratório:" textFill="#475569">
                                                    <font>
                                                        <Font name="Arial Bold" size="13.0" />
                                                    </font>
                                                </Label>
                                                <ChoiceBox fx:id="cbLaboratorio" prefHeight="35.0" prefWidth="160.0" styleClass="custom-choice-box" />
                                            </children>
                                        </HBox>

                                        <!-- Filtro de Status com Label -->
                                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                                            <children>
                                                <Label text="Situação:" textFill="#475569">
                                                    <font>
                                                        <Font name="Arial Bold" size="13.0" />
                                                    </font>
                                                </Label>
                                                <ChoiceBox fx:id="cbStatus" prefHeight="35.0" prefWidth="130.0" styleClass="custom-choice-box" />
                                            </children>
                                        </HBox>

                                        <!-- Botão Filtrar -->
                                        <Button mnemonicParsing="false" onAction="#onFiltrarClick" prefHeight="35.0" prefWidth="90.0" styleClass="btn-action-secondary" text="Filtrar">
                                            <font><Font name="Arial Bold" size="13.0" /></font>
                                        </Button>

                                        <Region HBox.hgrow="ALWAYS" />

                                        <!-- Botões de Ação -->
                                        <Button fx:id="btnAvaria" mnemonicParsing="false" onAction="#onRegistrarAvariaClick" prefHeight="35.0" prefWidth="140.0" styleClass="btn-action-danger" text=" Registrar Avaria">
                                            <font><Font name="Arial Bold" size="13.0" /></font>
                                        </Button>

                                        <Button mnemonicParsing="false" onAction="#onEditarClick" prefHeight="35.0" prefWidth="80.0" styleClass="btn-action-secondary" text="Editar">
                                            <font><Font name="Arial Bold" size="13.0" /></font>
                                        </Button>

                                        <Button mnemonicParsing="false" onAction="#onAdicionarClick" prefHeight="35.0" prefWidth="105.0" styleClass="btn-action-primary" text="Adicionar">
                                            <font><Font name="Arial Bold" size="13.0" /></font>
                                        </Button>
                                    </children>
                                </HBox>

                                <!-- Tabela de Inventário de Utensílios -->
                                <TableView fx:id="tabelaUtensilios" styleClass="table-view" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colItem" prefWidth="220.0" text="Item / Utensílio" />
                                        <TableColumn fx:id="colLaboratorio" prefWidth="160.0" text="Laboratório Atual" />
                                        <TableColumn fx:id="colStatus" prefWidth="120.0" text="Status" />
                                        <TableColumn fx:id="colQtdTotal" prefWidth="100.0" text="Qtd. Total" />
                                        <TableColumn fx:id="colQtdDisponivel" prefWidth="110.0" text="Qtd. Disponível" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>

                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </StackPane>
    </center>
</BorderPane>
